rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // ================= USERS =================

    match /users/{userId} {

      allow read:
        if request.auth != null &&
           request.auth.uid == userId;

      allow create:
        if request.auth != null &&
           request.auth.uid == userId;

      allow update:
        if request.auth != null &&
           request.auth.uid == userId;

      allow delete:
        if false;

      match /history/{historyId} {

        allow read, write:
          if request.auth != null &&
             request.auth.uid == userId;

      }

    }


    // ================= MANGA STATS =================

    match /mangaStats/{mangaId} {

      // Ai cũng xem được
      allow read:
        if true;

      // Chỉ cho tạo document nếu chưa có
      allow create:
        if true;

      // Ai cũng được update stats
      // Việc like/follow đã được JS chặn bằng đăng nhập
      allow update:
        if true;

    }


    // ================= COMMENTS =================

    match /comments/{mangaId}/messages/{commentId} {

      allow read:
        if true;

      allow create:
        if request.auth != null;

      allow update:
        if request.auth != null &&
           request.auth.uid == resource.data.uid;

      allow delete:
        if request.auth != null &&
           request.auth.uid == resource.data.uid;

    }

  }

}
